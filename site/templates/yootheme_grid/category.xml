<?xml version="1.0" encoding="utf-8"?>
<form>
	<author>FLEXIcontent Team</author>
	<website>www.flexicontent.org</website>
	<license>GPLv3</license>
	<version>1.0</version>
	<release>17 April 2026</release>
	<microdata_support>1</microdata_support>
	<defaulttitle>YOOtheme Grid</defaulttitle>
	<description>YOOtheme Pro / UIkit 3 compatible grid with featured + standard card styles</description>

	<fields name="attribs">
		<fieldset name="attribs" addfieldpath="/administrator/components/com_flexicontent/elements">

			<field name="items_sets_head_break" type="separator" level="level_br" />

			<!-- FEATURED -->
			<field name="items_tab_featured" type="separator" default="Featured items" icon_class="icon-list" level="tab_open" box_type="1" />
			<field name="items_tabset_featured_start" type="separator" default="ITEMS_FEATURED_TABSET" level="tabset_start" />

				<field name="items_tab_featured_placement" type="separator" default="FLEXI_PLACEMENT" icon_class="icon-grid" level="tab_open" box_type="1" />
					<field name="lead_num" type="list" default="1" label="# Featured items" description="Max 4. Grid adapts automatically.">
						<option value="0">0 - disabled</option>
						<option value="1">1 - Single hero</option>
						<option value="2">2 - Side by side</option>
						<option value="3">3 - Magazine</option>
						<option value="4">4 - Hero + grid</option>
					</field>
					<field name="items_featured_design" type="separator" default="Featured Card Design" icon_class="icon-grid" level="level2" />
					<field name="feat_card_style" type="list" default="hero" label="Card style">
						<option value="hero">Hero (image + content)</option>
						<option value="overlay">Overlay (text over image)</option>
						<option value="minimal">Minimal (no image)</option>
					</field>
					<field name="feat_img_position" type="radio" default="left" label="Image position (Hero only)" class="btn-group">
						<option value="left">Left</option>
						<option value="right">Right</option>
						<option value="top">Top</option>
						<option value="between">Between</option>
						<option value="bottom">Bottom</option>
					</field>
					<field name="feat_img_width" type="list" default="50" label="Image width % (Left/Right)">
						<option value="25">25%</option><option value="33">33%</option>
						<option value="40">40%</option><option value="50">50%</option>
						<option value="60">60%</option><option value="70">70%</option>
					</field>
					<field name="feat_content_valign" type="radio" default="top" label="Content alignment" class="btn-group">
						<option value="top">Top</option><option value="center">Center</option>
						<option value="bottom">Bottom</option><option value="between">Between</option>
					</field>
					<field name="feat_card_minheight" type="list" default="280" label="Card min height">
						<option value="180">180px</option><option value="240">240px</option>
						<option value="280">280px</option><option value="340">340px</option><option value="420">420px</option>
					</field>
					<field name="feat_animation" type="list" default="fade-up" label="Scroll animation">
						<option value="">None</option><option value="fade-up">Fade up</option>
						<option value="fade-in">Fade in</option><option value="slide-left">Slide left</option>
						<option value="zoom-in">Zoom in</option>
					</field>
					<field name="feat_uk_card_style" type="list" default="uk-card-default" label="UIkit card variant">
						<option value="uk-card-default">Default (white+shadow)</option>
						<option value="uk-card-primary">Primary (dark bg)</option>
						<option value="uk-card-secondary">Secondary (grey bg)</option>
						<option value="">None</option>
					</field>
					<field name="feat_uk_card_hover" type="radio" default="1" label="UIkit hover effect" class="btn-group btn-group-yesno">
						<option value="0">No</option><option value="1">Yes</option>
					</field>

				<field name="items_tab_featured_fields" type="separator" default="FLEXI_FIELDS" icon_class="icon-list" level="tab_open" box_type="1" />
					<field name="lead_image" type="radio" default="1" label="Show image" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
					<field name="lead_image_size" type="list" default="l" label="Image size"><option value="s">Small</option><option value="m">Medium</option><option value="l">Large</option><option value="o">Original</option></field>
					<field name="show_title" type="radio" default="1" label="Show title" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
					<field name="lead_cut_text" type="text" default="300" label="Excerpt length" class="input-small" />
					<field name="show_readmore" type="radio" default="1" label="Show read more" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
					<field name="show_editbutton" type="radio" default="1" label="Show edit button" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>

			<field name="items_tabset_featured_end" type="separator" level="tabset_end" />

			<!-- STANDARD -->
			<field name="items_tab_standard" type="separator" default="Standard items" icon_class="icon-list" level="tab_open" box_type="1" />
			<field name="items_tabset_standard_start" type="separator" default="ITEMS_STANDARD_TABSET" level="tabset_start" />

				<field name="items_tab_standard_placement" type="separator" default="FLEXI_PLACEMENT" icon_class="icon-grid" level="tab_open" box_type="1" />
					<field name="items_standard_basic" type="separator" default="Standard Card Design" icon_class="icon-grid" level="level2" />
					<field name="std_card_style" type="list" default="classic" label="Card style">
						<option value="classic">Classic (image top)</option>
						<option value="horizontal">Horizontal list</option>
						<option value="overlay">Overlay</option>
						<option value="minimal">Minimal</option>
						<option value="magazine">Magazine row</option>
					</field>
					<field name="std_img_width" type="list" default="33" label="Image width % (Horizontal/Magazine)">
						<option value="20">20%</option><option value="25">25%</option>
						<option value="33">33%</option><option value="40">40%</option><option value="50">50%</option>
					</field>
					<field name="std_card_minheight" type="list" default="200" label="Card min height (Overlay)">
						<option value="160">160px</option><option value="200">200px</option>
						<option value="240">240px</option><option value="280">280px</option>
					</field>
					<field name="std_animation" type="list" default="fade-up" label="Scroll animation">
						<option value="">None</option><option value="fade-up">Fade up</option>
						<option value="fade-in">Fade in</option><option value="zoom-in">Zoom in</option>
						<option value="slide-left">Slide left</option>
					</field>
					<field name="uk_grid_cols_desktop" type="list" default="3" label="Columns (desktop &gt;=960px)">
						<option value="1">1</option><option value="2">2</option><option value="3">3</option>
						<option value="4">4</option><option value="5">5</option><option value="6">6</option>
					</field>
					<field name="uk_grid_cols_tablet" type="list" default="2" label="Columns (tablet &gt;=640px)">
						<option value="1">1</option><option value="2">2</option><option value="3">3</option>
					</field>
					<field name="uk_grid_cols_mobile" type="list" default="1" label="Columns (mobile)">
						<option value="1">1</option><option value="2">2</option>
					</field>
					<field name="uk_grid_gap" type="list" default="" label="Grid gap">
						<option value="">Default</option><option value="uk-grid-small">Small</option>
						<option value="uk-grid-medium">Medium</option><option value="uk-grid-large">Large</option>
						<option value="uk-grid-collapse">None</option>
					</field>
					<field name="std_uk_card_style" type="list" default="uk-card-default" label="UIkit card variant">
						<option value="uk-card-default">Default</option>
						<option value="uk-card-primary">Primary</option>
						<option value="uk-card-secondary">Secondary</option>
						<option value="uk-card-body">Body only</option>
						<option value="">None</option>
					</field>
					<field name="std_uk_card_hover" type="radio" default="1" label="UIkit hover effect" class="btn-group btn-group-yesno">
						<option value="0">No</option><option value="1">Yes</option>
					</field>
					<field name="uk_img_ratio" type="list" default="16-9" label="Image aspect ratio">
						<option value="1-1">1:1</option><option value="4-3">4:3</option>
						<option value="16-9">16:9</option><option value="3-2">3:2</option><option value="">Auto</option>
					</field>
					<field name="ibox_minsize_std" type="list" cssprep="less" default="260px" label="Fallback column size">
						<option value="100%">1 col</option><option value="480px">2 cols</option>
						<option value="300px">2-3 cols</option><option value="220px">3-4 cols</option>
					</field>

				<field name="items_tab_standard_fields" type="separator" default="FLEXI_FIELDS" icon_class="icon-list" level="tab_open" box_type="1" />
					<field name="intro_image" type="radio" default="1" label="Show image" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
					<field name="intro_image_size" type="list" default="l" label="Image size"><option value="s">Small</option><option value="m">Medium</option><option value="l">Large</option><option value="o">Original</option></field>
					<field name="show_introtext" type="radio" default="1" label="Show introtext" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
					<field name="intro_cut_text" type="text" default="180" label="Excerpt length" class="input-small" />
					<field name="show_readmore" type="radio" default="1" label="Show read more" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
					<field name="show_editbutton" type="radio" default="1" label="Show edit button" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>

			<field name="items_tabset_standard_end" type="separator" level="tabset_end" />

			<!-- DISPLAY OPTIONS -->
			<field name="items_tab_content_display_options" type="separator" default="FLEXI_COMMON" icon_class="icon-screen" level="tab_open" box_type="1" />
				<field name="show_pagination" type="list" default="2" label="FLEXI_PAGINATION"><option value="0">Hide</option><option value="1">Show</option><option value="2">Auto</option></field>
				<field name="use_search" type="radio" default="1" label="FLEXI_USE_SEARCH" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
				<field name="use_alpha_index" type="radio" default="1" label="FLEXI_USE_ALPHA_INDEX" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
				<field name="use_lazy_loading" type="radio" default="1" label="Lazy loading" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>
				<field name="link_titles" type="radio" default="1" label="FLEXI_LINK_TITLES" class="btn-group btn-group-yesno"><option value="0">No</option><option value="1">Yes</option></field>

		</fieldset>
	</fields>
</form>
