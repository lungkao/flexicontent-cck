<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="basic">

		<field
			name="id"
			type="hidden"
		/>

		<field
			name="title"
			type="text"
			label="FLEXI_TITLE"
			required="true"
			class="form-control"
			size="80"
		/>

		<field
			name="description"
			type="textarea"
			label="JGLOBAL_DESCRIPTION"
			rows="3"
			class="form-control"
		/>

		<field
			name="layout"
			type="list"
			label="FLEXI_MODULEPRESET_LAYOUT"
			default="modern"
			class="form-select"
		>
			<option value="modern">Modern</option>
			<option value="news">News</option>
			<option value="carousel">Carousel</option>
			<option value="default">Default</option>
		</field>

		<field
			name="tags"
			type="text"
			label="FLEXI_MODULEPRESET_FIELD_TAGS_LABEL"
			hint="FLEXI_MODULEPRESET_FIELD_TAGS_HINT"
			class="form-control"
			size="80"
		/>

		<field
			name="params_json"
			type="textarea"
			label="FLEXI_MODULEPRESET_FIELD_PARAMS_JSON_LABEL"
			description="FLEXI_MODULEPRESET_FIELD_PARAMS_JSON_DESC"
			rows="8"
			class="form-control font-monospace"
		/>

		<field
			name="state"
			type="list"
			label="JSTATUS"
			default="1"
			class="form-select"
		>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field
			name="ordering"
			type="text"
			label="JFIELD_ORDERING_LABEL"
			default="0"
			filter="integer"
			class="form-control"
		/>

	</fieldset>
</form>
